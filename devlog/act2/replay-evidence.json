            },
            {
              "groupId": "student_south",
              "role": "【居住】南侧学生宿院",
              "intent": "中央平原南段形成第二宿院，避免集中一座楼；近食堂和生活服务，岸边留开放绿带。"
            },
            {
              "groupId": "faculty",
              "role": "【居住】教师与常住服务人员居住",
              "intent": "西北平原林缘布置多户研究住宅，家庭生活与私下研究分开，保留组间树带。"
            },
            {
              "groupId": "care",
              "role": "【公共】医护休养与卫生服务",
              "intent": "两宿院与教学交界，诊疗、休养庭院、洗浴洗衣分别组织，避免货运穿院。"
            },
            {
              "groupId": "scriptorium",
              "role": "【工作】抄写装订与学术供应",
              "intent": "藏书区外缘接教学，文献抄写和书籍制作成院，与公众借阅通路相连。"
            },
            {
              "groupId": "botanical",
              "role": "【工作】植物教学与苗圃",
              "intent": "东北平原29承担温室、药草教学、育苗与工具管理，以种植庭院延伸到林缘，不把大片陆地仅留空。"
            },
            {
              "groupId": "logistics",
              "role": "【工作】仓储与物资服务",
              "intent": "东岸迎客后侧独立货物院接市场和实验院，客货分路；南东小岛与西侧沙洲保留生态岸线，不设孤立城区。"
            }
