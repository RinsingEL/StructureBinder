  "checks": {
    "形体与布局": "三个房间分布于高低两台，低院遮棚与中段短阶组织公共通路；整体保持真实一格高差。",
    "内饰与使用": "下台厨房起居，上台双床房及家务凉室；两床、家务桌和上台通道全部有标记。",
    "标记与通路": "已查看四向外观、俯视、去屋顶、楼层、房间、使用点和标记图；最终 NBT 的入口至已标站位通过碰撞初筛。",
    "因地制宜": "有稳定生活用水的干热聚落，通风方向与遮阳不被邻屋完全堵塞；前低后高两台住宅，低院炊事、上台睡眠与家务，用内院短阶衔接一格高差。；独立住宅模板，庭院及其硬地属于实际占地；未写入格保留原环境；主入口脚底 Y=2；上台脚底 Y=3。已查看匹配条件的沙地或微坡示意。",
    "风塔接口": "最终 NBT 的四格塔内空腔穿过屋顶接入房间；与三处旧模型一起复核 11 条连续空腔，几何未被顶板封堵。"
  },
  "revisions": [
    "主入口移到前院开口 X=23，上台交通点朝向中央通道；补充房间外窗。",
