# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf
runtime/hermes/*.zip filter=lfs diff=lfs merge=lfs -text
runclient-t3-12realm-monotonic.out.log filter=lfs diff=lfs merge=lfs -text
runtime/harness/*.zip filter=lfs diff=lfs merge=lfs -text
saves/*.zip filter=lfs diff=lfs merge=lfs -text
# Preserve byte-level hashes in captured local experiment evidence.
runtime/** -text
tmp/** -text
